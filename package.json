{
  "name": "openwork-mcp-app-examples",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm build && vite --config playground/vite.config.ts --open /",
    "dev:atlas": "MCP_EXAMPLE_APP=project-atlas VITE_REMOTE_APP_VERSION=local-dev vite --config vite.config.ts --open /",
    "dev:capabilities": "MCP_EXAMPLE_APP=capability-explorer VITE_REMOTE_APP_VERSION=local-dev vite --config vite.config.ts --open /",
    "dev:gallery": "MCP_EXAMPLE_APP=component-gallery VITE_REMOTE_APP_VERSION=local-dev vite --config vite.config.ts --open /",
    "start:mcp": "node scripts/mcp-server.mjs",
    "build": "node scripts/build-examples.mjs",
    "check": "node scripts/check-build.mjs",
    "check:types": "tsc --noEmit",
    "check:mcp": "node scripts/check-mcp-server.mjs",
    "verify": "pnpm check:types && pnpm build && pnpm check && pnpm check:mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
